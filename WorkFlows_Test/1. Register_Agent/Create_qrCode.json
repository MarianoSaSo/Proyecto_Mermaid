    {
      "parameters": {
        "description": "Herramienta capaz de crear un codigo qr",
        "jsCode": "const QRCode = require('qrcode');\n\n// Entrada del subagente\nconst userId = $json.id;\n\n// IP local de tu servidor\nconst baseUrl = \"http://192.168.0.91:3000\";\n\n// Construir URL de perfil\nconst profileUrl = `${baseUrl}/profile/${userId}`;\n\n// Generar QR en base64\nconst qrBase64 = await QRCode.toDataURL(profileUrl);\nconst base64Data = qrBase64.replace(/^data:image\\/png;base64,/, \"\");\nconst buffer = Buffer.from(base64Data, 'base64');\n\nreturn [{\n  json: {\n    id: userId,\n    profile_url: profileUrl\n  },\n  binary: {\n    qr: {\n      data: buffer,\n      mimeType: 'image/png',\n      fileName: `${userId}.png`\n    }\n  }\n}];"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        224,
        208
      ],
      "id": "a6e8e3cb-0982-457f-b1df-6c9c1b5b0145",
      "name": "Code Tool1"
    },
    {
      "parameters": {
        "jsCode": "// Tomamos el string que devuelve el subagente\nconst qrString = $json[\"output\"];\n\n// Convertimos a objeto JSON\nconst qrData = JSON.parse(qrString);\n\nreturn [{\n  json: qrData\n}];"
      },
