			/* Estilos para el botÃ³n del menÃº toggle */
.menu-toggle {
    background-color: transparent !important; /* Fondo transparente */
    border: 2px solid white; /* Borde blanco */
    padding: 10px;
	border-radius: 5px;
    cursor: pointer;
}

/* Estilos para los Ã­conos de menÃº (hamburguesa y cerrar) */
.menu-toggle .mobile-menu-toggle-icon svg {
    fill: white !important; /* Hace que el Ã­cono sea de color blanco */
    width: 24px;
    height: 24px;
}

/* Ajuste del color del borde al pasar el mouse sobre el toggle */
.menu-toggle:hover {
    border-color: #f0f0f0; /* Cambia el borde al pasar el mouse */
}

/* Estilos para el Ã­cono de cerrar el menÃº */
.menu-toggle.toggled .ast-close-svg {
    fill: white !important; /* Asegura que el Ã­cono de cerrar tambiÃ©n sea blanco */
}
		</style>
		</head>

